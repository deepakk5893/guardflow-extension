{
  "manifest_version": 3,
  "name": "Niyantra - AI Chat Security & PII Protection",
  "version": "2.0.0",
  "description": "Block secrets & PII in ChatGPT, Claude, Gemini, Perplexity, Grok. Auto-redact sensitive data before sending.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*",
    "https://*.guardflow.tech/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["../../src/content/content.ts"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "../../src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "public/popup.html",
    "default_title": "Niyantra - AI Security",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
